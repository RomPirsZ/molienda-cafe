---
import '@fontsource/sofia-sans-extra-condensed/latin-800.css';
import '@fontsource/sofia-sans/latin-400.css';
import '@fontsource/sofia-sans/latin-400-italic.css';
import '@fontsource/sofia-sans/latin-600.css';
import '@fontsource/sofia-sans/latin-700.css';
import '../styles/global.css';
import { t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { title = t('sitio.titulo'), description = t('sitio.descripcion') } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Mismo color que --noche: la barra del navegador móvil continúa la página -->
    <meta name="theme-color" content="rgb(23 17 13)" />
    <meta name="color-scheme" content="only dark" />
    <!--
      `js`: hay JavaScript (el panel y el ticket existen; sin JS, sus alternativas).
      `motion`: con JS y sin reduced-motion, lo que se va a revelar nace oculto
      (global.css) hasta que GSAP lo tome. Si el módulo no llega, el CSS lo muestra igual
      a los 2,5 s: el contenido nunca depende de JS (constitución I).
      Con CSP, este script necesita su hash (public/_headers).
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-pergamino focus:text-noche focus:px-4 focus:py-2"
      >{t('nav.saltar')}</a
    >
    <slot />
    <script>
      import { startMotion } from '../lib/motion';
      startMotion();
    </script>
  </body>
</html>
