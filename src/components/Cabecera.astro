---
// Cabecera (spec §10.3): el nombre a la izquierda (vuelve al inicio) y, a la derecha, el
// botón que abre el panel de secciones. Sin JS, ese botón es un enlace a la navegación del
// pie: el panel necesita JS y sin él no se enseña (html.js, global.css).
import { t } from '../i18n';
---

<header class="cabecera" data-cabecera>
  <div class="contenedor cabecera-fila">
    <a href="#inicio" class="cabecera-marca" aria-label={t('nav.inicio')}>{t('marca.nombre')}</a>
    <a href="#navegacion" class="cabecera-boton solo-sin-js">{t('panel.abrir')}</a>
    <button type="button" class="cabecera-boton solo-con-js" aria-controls="panel" aria-expanded="false" data-abrir-panel>
      {t('panel.abrir')}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--noche);
  }
  .cabecera-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }
  .cabecera-marca {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .cabecera-boton {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 0;
    background: var(--pergamino);
    color: var(--noche);
    font: 700 0.9375rem/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cabecera-boton:hover {
    background: var(--frailejon);
  }
  .cabecera-boton svg {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
