---
// Visítanos (spec §4 y §6): la zona, sin dirección ni mapa (ficticia), y el horario
// completo. El lunes cerrado no se omite: va como fila apagada. Con JS, el día
// de hoy se marca (aria-current) y el estado de apertura aparece encima.
import { t } from '../i18n';
import { HORARIO } from '../data/horario';
import { formatearHora, nombreDia, type Dia } from '../lib/opening-hours';
import EstadoApertura from './EstadoApertura.astro';

// La semana empieza el lunes
const dias: Dia[] = [1, 2, 3, 4, 5, 6, 0];
const mayuscula = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<section id="visitanos" class="visitanos" aria-labelledby="visitanos-titulo">
  <div class="visitanos-franja">
    <div class="contenedor visitanos-rejilla">
      <div>
        <h2 id="visitanos-titulo" class="titulo-seccion" data-revelar="titulo">{t('visitanos.titulo')}</h2>
        <p class="visitanos-zona">{t('visitanos.zona')}</p>
        <p class="visitanos-nota">{t('visitanos.zonaNota')}</p>
        <EstadoApertura class="visitanos-estado" />
      </div>
      <div id="horario" class="horario-bloque">
        <h3 class="horario-titulo">{t('horario.titulo')}</h3>
        <dl class="horario">
          {
            dias.map((d) => {
              const tramo = HORARIO[d];
              return (
                <div class:list={['horario-fila', { 'horario-fila--cerrado': !tramo }]} data-dia={d}>
                  <dt>{mayuscula(nombreDia(d))}</dt>
                  <dd class="cifras">
                    {tramo
                      ? t('horario.tramo', { abre: formatearHora(tramo.abre), cierra: formatearHora(tramo.cierra) })
                      : t('horario.cerrado')}
                  </dd>
                </div>
              );
            })
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .visitanos-franja {
    background: var(--espresso);
    color: var(--pergamino);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .visitanos-rejilla {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64rem) {
    .visitanos-rejilla {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
  .visitanos-zona {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-bloque);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .visitanos-nota {
    margin: 0.5rem 0 0;
    color: var(--pergamino-suave);
  }
  .visitanos :global(.visitanos-estado) {
    margin-top: 1.5rem;
    color: var(--frailejon);
  }
  .horario-titulo {
    margin: 0 0 0.75rem;
    color: var(--frailejon);
    font-size: var(--text-bloque);
  }
  .horario {
    margin: 0;
    border-top: 1px solid var(--pergamino);
  }
  .horario-fila {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.5rem;
    border-bottom: 1px solid var(--linea);
  }
  .horario-fila dt,
  .horario-fila dd {
    margin: 0;
  }
  /* Día cerrado: fila apagada (un tono más oscuro), pero legible */
  .horario-fila--cerrado {
    background: var(--noche);
  }
  .horario-fila--cerrado dd {
    color: var(--pergamino-suave);
  }
  /* Hoy (lo marca el script del estado de apertura): en negrita, con un cuadro frailejón */
  .horario-fila[aria-current='date'] {
    font-weight: 700;
  }
  .horario-fila[aria-current='date'] dt::before {
    content: '';
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.6rem;
    background: var(--frailejon);
  }
</style>
