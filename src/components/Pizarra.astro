---
// Pizarra de acera (contrato de dirección, FIRST VIEWPORT): un caballete delante de la
// casona con los tres primeros cafés de la carta y su precio. Es texto de verdad, no
// parte del dibujo: se lee, se traduce y se ve sin JS.
import { t } from '../i18n';
import { CARTA, precio } from '../data/carta';

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
const destacados = CARTA[0]!.platos.slice(0, 3);
---

<div class:list={['pizarra', clase]}>
  <div class="pizarra-tablero">
    <h2 class="pizarra-titulo etiqueta">{t('hero.hoy')}</h2>
    <ul class="pizarra-lista">
      {
        destacados.map((p) => (
          <li class="pizarra-fila hero-cafe">
            <span>{t(p.nombre)}</span>
            <span class="cifras">{precio(p.precio)}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="pizarra-pata pizarra-pata--izq" aria-hidden="true"></span>
  <span class="pizarra-pata pizarra-pata--der" aria-hidden="true"></span>
</div>

<style>
  .pizarra {
    position: relative;
    width: 13.5rem;
    padding-bottom: 1rem;
  }
  .pizarra-tablero {
    position: relative;
    z-index: 1;
    padding: 0.6rem 0.8rem 0.7rem;
    background: var(--pizarra);
    border: 0.4rem solid var(--tostado);
  }
  .pizarra-titulo {
    margin: 0 0 0.4rem;
    color: var(--frailejon);
    font-family: var(--font-sans);
    line-height: 1.3;
  }
  .pizarra-lista {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pizarra-fila {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }
  /* Las patas del caballete, hasta la acera */
  .pizarra-pata {
    position: absolute;
    bottom: 0;
    width: 0.4rem;
    height: 2rem;
    background: var(--tostado);
  }
  .pizarra-pata--izq {
    left: 0.9rem;
    rotate: 6deg;
  }
  .pizarra-pata--der {
    right: 0.9rem;
    rotate: -6deg;
  }
  @media (max-width: 47.99rem) {
    .pizarra {
      width: 8.75rem;
    }
    .pizarra {
      padding-bottom: 0.5rem;
    }
    .pizarra-tablero {
      padding: 0.45rem 0.55rem 0.5rem;
      border-width: 0.3rem;
    }
    .pizarra-pata {
      height: 1.3rem;
    }
    .pizarra-fila {
      font-size: 0.8125rem;
      gap: 0.4rem;
    }

  }
</style>
