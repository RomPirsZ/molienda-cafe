---
// Carta (spec §4): tres columnas (café, panadería, desayunos y brunch) en lista, como en
// la referencia: nombre en la serif, precio alineado a la derecha con cifras tabulares,
// una línea de descripción y, en los cafés, su procedencia. El aviso de precios ficticios
// va arriba, a la vista, no en letra pequeña al final.
import { t } from '../i18n';
import { CARTA, precio } from '../data/carta';
import Foto from './Foto.astro';
---

<section id="carta" class="carta" aria-labelledby="carta-titulo" data-seccion="taza">
  <div class="contenedor">
    <header class="carta-cabeza">
      <h2 id="carta-titulo" class="carta-titulo" data-revelar="titulo">{t('carta.titulo')}</h2>
      <p class="carta-aviso etiqueta">{t('carta.aviso')}</p>
    </header>

    <div class="carta-columnas">
      {
        CARTA.map((categoria) => (
          <section class="categoria" aria-labelledby={`cat-${categoria.id}`}>
            <h3 id={`cat-${categoria.id}`} class="categoria-titulo">
              {t(categoria.titulo)}
            </h3>
            {categoria.id === 'panaderia' && (
              <Foto foto="panAndino" proporcion="3 / 2" sizes="(min-width: 64rem) 22rem, 92vw" class="categoria-foto" />
            )}
            <ul class="platos" data-revelar="platos">
              {categoria.platos.map((p) => (
                <li class="plato">
                  <p class="plato-fila">
                    <span class="plato-nombre">{t(p.nombre)}</span>
                    <span class="plato-precio cifras">{precio(p.precio)}</span>
                  </p>
                  <p class="plato-desc">{t(p.descripcion)}</p>
                  {p.origen && (
                    <p class="plato-origen etiqueta cifras">
                      {t(p.origen.finca)} · {p.origen.region} · {t('carta.altitud', { metros: p.origen.altitud.toLocaleString('es-VE') })}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="carta-nota">{t('carta.fincasNota')}</p>
  </div>
</section>

<style>
  .carta {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .carta-cabeza {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }
  .carta-titulo {
    margin: 0;
    font-size: var(--text-titulo);
    letter-spacing: var(--tracking-marca);
    text-transform: uppercase;
    margin-right: calc(var(--tracking-marca) * -1);
  }
  .carta-aviso {
    margin: 0;
    color: var(--tinta-suave);
  }
  .carta-columnas {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3rem);
  }
  @media (min-width: 64rem) {
    .carta-columnas {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
  .categoria-titulo {
    margin: 0;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--tinta);
    font-size: 1.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .categoria :global(.categoria-foto) {
    margin-top: 1.25rem;
    rotate: -1.5deg;
  }
  .platos {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .plato {
    padding-block: 1rem;
    border-bottom: 1px solid var(--linea);
  }
  .plato-fila {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-size: var(--text-plato);
  }
  .plato-nombre {
    font-family: var(--font-display);
  }
  /* Línea de puntos entre el nombre y el precio, como en una carta impresa */
  .plato-fila::after {
    content: '';
    order: 1;
    flex: 1;
    border-bottom: 1px dotted var(--linea);
    transform: translateY(-0.3em);
  }
  .plato-precio {
    order: 2;
    font-size: 1.0625rem;
  }
  .plato-desc {
    margin: 0.25rem 0 0;
    color: var(--tinta-suave);
  }
  .plato-origen {
    margin: 0.35rem 0 0;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
  }
  .carta-nota {
    margin: 2rem 0 0;
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }
</style>
