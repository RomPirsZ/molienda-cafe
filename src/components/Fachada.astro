<style>
  /* La caja mantiene la proporción del dibujo: lo que va encima se coloca en % y su
     letra se mide en cqi (ancho de la fachada), así escala con el dibujo */
  .fachada {
    position: relative;
    aspect-ratio: 2400 / 1000;
    container-type: inline-size;
  }
  .fachada-dibujo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .c-noche { fill: var(--noche); }
  .c-estrella { fill: var(--pergamino); opacity: 0.55; }
  .c-monte { fill: var(--monte); }
  .c-nieve { fill: var(--pergamino-suave); }
  .c-oliva { fill: var(--oliva); }
  .c-muro { fill: var(--muro); }
  .c-muro-vecino { fill: var(--muro); opacity: 0.6; }
  .c-espresso { fill: var(--espresso); }
  .c-ventana-vecina { fill: var(--apagado); }
  .c-teja { fill: var(--teja); }
  .c-teja-canal { fill: var(--noche); opacity: 0.28; }
  .c-tostado { fill: var(--tostado); }
  .c-linea { fill: var(--linea); }
  .c-trazo { fill: none; stroke: var(--tostado); stroke-width: 5; }
  .c-frailejon { fill: var(--frailejon); }
  .c-luna { fill: var(--luz); }
  .c-luz {
    fill: var(--luz);
    transition: fill 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Cerrado: las ventanas y la puerta se apagan (la del vecino sigue encendida) */
  .fachada[data-abierto='false'] .c-luz:not(.c-luz-vecina) {
    fill: var(--apagado);
  }

  .fachada-letrero {
    position: absolute;
    left: 42.4%;
    top: 60.4%;
    width: 15.2%;
    height: 4.6%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.9cqi;
    color: var(--pergamino);
  }
  .fachada-letrero-nombre {
    font-family: var(--font-display);
    font-size: 1.75cqi;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .fachada-letrero-sub {
    font-size: 0.5cqi;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Placa colgada en el portón: ABIERTO o CERRADO, en vivo */
  .fachada-placa {
    position: absolute;
    left: 50%;
    top: 69.4%;
    translate: -50% 0;
    margin: 0;
    padding: 0.25cqi 0.6cqi;
    background: var(--pergamino);
    color: var(--noche);
    font-family: var(--font-display);
    font-size: 1.05cqi;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .fachada-placa-abre {
    display: block;
    margin-top: 0.15cqi;
    font-family: var(--font-sans);
    font-size: max(0.75rem, 0.6cqi);
    font-weight: 700;
  }
  .fachada-placa-abre[hidden] {
    display: none;
  }
  /* En el móvil la pizarra tapa ese lado del letrero: basta con el nombre */
  @container (max-width: 80rem) {
    .fachada-letrero {
      justify-content: center;
    }
    .fachada-letrero-sub {
      display: none;
    }
  }
  .fachada-placa[hidden] {
    display: none;
  }
</style>
