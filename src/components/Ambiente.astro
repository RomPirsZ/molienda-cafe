---
// Ambiente (spec §4): galería de fotos de ambientación en composición escalonada, con un
// texto corto y la nota de que no muestran el café (PRODUCT.md: honestidad).
import { t } from '../i18n';
import Foto from './Foto.astro';
---

<section class="ambiente" aria-labelledby="ambiente-titulo">
  <div class="contenedor ambiente-rejilla">
    <div class="ambiente-texto">
      <h2 id="ambiente-titulo" class="titulo-seccion ambiente-titulo" data-revelar="titulo">{t('ambiente.titulo')}</h2>
      <p>{t('ambiente.texto')}</p>
      <p class="ambiente-nota">{t('ambiente.nota')}</p>
    </div>
    <Foto foto="tazaEnMano" proporcion="3 / 2" sizes="(min-width: 64rem) 40rem, 92vw" class="ambiente-taza" />
    <Foto foto="tostador" proporcion="4 / 5" sizes="(min-width: 64rem) 22rem, 56vw" class="ambiente-tostador" />
    <Foto foto="preparacion" proporcion="3 / 2" sizes="(min-width: 64rem) 30rem, 80vw" class="ambiente-preparacion" />
  </div>
</section>

<style>
  .ambiente {
    padding-block: clamp(2rem, 6vw, 5rem) clamp(4rem, 9vw, 7rem);
  }
  .ambiente-rejilla {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem 1rem;
  }
  .ambiente-texto {
    grid-column: 1 / -1;
  }
  .ambiente-titulo {
    margin-bottom: 1rem;
  }
  .ambiente-texto > p {
    max-width: 26rem;
    margin: 0;
  }
  .ambiente-texto > .ambiente-nota {
    margin-top: 1rem;
    color: var(--pergamino-suave);
    font-size: 0.9375rem;
  }
  .ambiente-rejilla :global(.ambiente-taza) {
    grid-column: 1 / -1;
  }
  /* Las dos fotos pequeñas comparten fila y se solapan, superpuestas */
  .ambiente-rejilla :global(.ambiente-tostador) {
    grid-column: 1 / 7;
    grid-row: 3;
    margin-top: -2rem;
  }
  .ambiente-rejilla :global(.ambiente-preparacion) {
    grid-column: 6 / -1;
    grid-row: 3;
    align-self: end;
    margin-bottom: -1.5rem;
  }
  @media (min-width: 64rem) {
    .ambiente-rejilla {
      grid-template-rows: auto auto;
      align-items: start;
    }
    /* Revisión final de impeccable: el texto arranca a la altura del borde superior de la
       foto grande, y el tostador sube a solaparse con su esquina inferior izquierda, como
       en Origen; así no queda un vacío bajo el título ni una foto huérfana. */
    .ambiente-texto {
      grid-column: 1 / 5;
      grid-row: 1;
      align-self: start;
      padding-top: 0.85rem;
    }
    .ambiente-rejilla :global(.ambiente-taza) {
      grid-column: 5 / -1;
      grid-row: 1;
    }
    .ambiente-rejilla :global(.ambiente-tostador) {
      position: relative;
      z-index: 1;
      grid-column: 3 / 7;
      grid-row: 1 / 3;
      align-self: end;
      margin-bottom: 1.5rem;
    }
    .ambiente-rejilla :global(.ambiente-preparacion) {
      grid-column: 6 / 11;
      grid-row: 2;
      align-self: start;
      margin-top: -4rem;
      margin-bottom: 0;
    }
  }
</style>
