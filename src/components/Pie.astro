---
// Pie (spec §4): el aviso de concepto, los créditos de cada foto (autor, licencia y el
// cambio hecho, como piden CC BY y CC BY-SA) y el año.
import { t } from '../i18n';
import { FOTOS } from '../data/fotos';
import Sello from './Sello.astro';

const anio = String(new Date().getFullYear());
---

<footer class="pie">
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <Sello decorativo class="w-20" />
      <p class="pie-concepto">{t('pie.concepto')}</p>
      <p class="etiqueta">{t('pie.anio', { anio })}</p>
    </div>
    <div>
      <h2 class="pie-titulo etiqueta">{t('creditos.titulo')}</h2>
      <ul class="pie-creditos">
        {
          Object.values(FOTOS).map((f) => (
            <li>
              <a href={f.fuente} rel="noopener">{t(f.alt)}</a>: {f.autor},{' '}
              <a href={f.licenciaUrl} rel="license noopener">{f.licencia}</a>,{' '}
              {'recortada' in f && f.recortada ? t('creditos.cambiosRecorte') : t('creditos.cambios')}.
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    color: var(--tinta-suave);
    font-size: 0.9375rem;
  }
  .pie-rejilla {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 64rem) {
    .pie-rejilla {
      grid-template-columns: 1fr 2fr;
    }
  }
  .pie-marca {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .pie-marca p {
    margin: 0;
  }
  .pie-concepto {
    max-width: 22rem;
    color: var(--tinta);
  }
  .pie-titulo {
    margin: 0 0 0.75rem;
    color: var(--tinta);
  }
  /* Más de veinte créditos (CC BY y BY-SA piden citarlos): en columnas desde 768 px */
  .pie-creditos {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .pie-creditos li {
    margin-bottom: 0.45rem;
    break-inside: avoid;
  }
  @media (min-width: 48rem) {
    .pie-creditos {
      columns: 2;
      column-gap: 2.5rem;
    }
  }
  .pie a {
    color: inherit;
  }
  .pie a:hover {
    color: var(--accion);
  }
</style>
