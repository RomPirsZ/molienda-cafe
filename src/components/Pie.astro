---
// Pie (spec §10.3): la navegación de la página (sin JS es el destino del botón
// «Secciones»), el aviso de concepto, los créditos de cada foto (autor, licencia y el
// cambio hecho, como piden CC BY y CC BY-SA) y el año.
import { t } from '../i18n';
import { FOTOS } from '../data/fotos';
import { SECCIONES } from '../data/secciones';

const anio = String(new Date().getFullYear());
---

<footer class="pie">
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{t('marca.nombre')}</p>
      <p class="pie-concepto">{t('pie.concepto')}</p>
      <p class="etiqueta">{t('pie.anio', { anio })}</p>
    </div>
    <nav id="navegacion" class="pie-nav" aria-label={t('nav.pie')}>
      <h2 class="pie-titulo etiqueta">{t('pie.navTitulo')}</h2>
      <ul>
        {
          SECCIONES.map((s) => (
            <li>
              <a href={s.href}>{t(s.nombre)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="pie-creditos-bloque">
      <h2 class="pie-titulo etiqueta">{t('creditos.titulo')}</h2>
      <ul class="pie-creditos">
        {
          Object.values(FOTOS).map((f) => (
            <li>
              <a href={f.fuente} rel="noopener">{t(f.alt)}</a>: {f.autor},{' '}
              <a href={f.licenciaUrl} rel="license noopener">{f.licencia}</a>,{' '}
              {'recortada' in f && f.recortada ? t('creditos.cambiosRecorte') : t('creditos.cambios')}.
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    color: var(--pergamino-suave);
    font-size: 0.9375rem;
  }
  .pie-rejilla {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 64rem) {
    .pie-rejilla {
      grid-template-columns: 1fr 1fr 2fr;
    }
  }
  .pie-marca {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .pie-marca p {
    margin: 0;
  }
  .pie-nombre {
    color: var(--pergamino);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .pie-concepto {
    max-width: 22rem;
    color: var(--pergamino);
  }
  .pie-titulo {
    margin: 0 0 0.75rem;
    color: var(--pergamino);
  }
  .pie-nav ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pie-nav a {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--pergamino);
    font-family: var(--font-display);
    font-size: var(--text-plato);
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }
  .pie-nav a:hover {
    color: var(--frailejon);
  }
  /* Más de veinte créditos (CC BY y BY-SA piden citarlos): en columnas desde 768 px */
  .pie-creditos {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .pie-creditos li {
    margin-bottom: 0.45rem;
    break-inside: avoid;
  }
  @media (min-width: 48rem) {
    .pie-creditos {
      columns: 2;
      column-gap: 2.5rem;
    }
  }
  .pie-creditos a:hover {
    color: var(--frailejon);
  }
</style>
