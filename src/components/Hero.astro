---
// Primer viewport (contrato de dirección, FIRST VIEWPORT): sello centrado, «MOLIENDA»
// grande y espaciado, la tira terracota rasgada con el lema, el aviso de concepto y la
// carta empezando ya: tres cafés con precio y origen, y la acción «Ver la carta».
import { t } from '../i18n';
import { CARTA, precio } from '../data/carta';
import Sello from './Sello.astro';
import PapelRasgado from './PapelRasgado.astro';
import EstadoApertura from './EstadoApertura.astro';

const destacados = CARTA[0]!.platos.slice(0, 3);
---

<section id="inicio" class="hero" aria-labelledby="titulo">
  <div class="contenedor hero-cabeza">
    <Sello class="hero-sello" />
    <h1 id="titulo" class="hero-titulo" data-revelar="titulo">{t('marca.nombre')}</h1>
  </div>

  <div class="hero-tira" style="--rasgado-color: var(--accion)" data-revelar="tira">
    <PapelRasgado corte={2} />
    <p class="hero-lema etiqueta">{t('hero.lema')}</p>
    <PapelRasgado lado="abajo" />
  </div>

  <div class="contenedor hero-cuerpo">
    <p class="hero-texto">{t('hero.texto')}</p>
    <p class="hero-aviso">{t('concepto.aviso')}</p>
    <EstadoApertura class="hero-estado" />

    <h2 class="hero-hoy etiqueta">{t('hero.hoy')}</h2>
    <ul class="hero-cafes" data-revelar="platos">
      {
        destacados.map((p) => (
          <li class="hero-cafe">
            <p class="hero-cafe-fila">
              <span class="hero-cafe-nombre">{t(p.nombre)}</span>
              <span class="cifras">{precio(p.precio)}</span>
            </p>
            {p.origen && (
              <p class="hero-cafe-origen etiqueta cifras">
                {t(p.origen.finca)} · {p.origen.region} ·{' '}
                {t('carta.altitud', { metros: p.origen.altitud.toLocaleString('es-VE') })}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <a href="#carta" class="boton-accion hero-cta">
      {t('hero.cta')}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <path d="M12 4v16M5 13l7 7 7-7"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 2.5vh, 3rem) clamp(2.5rem, 6vh, 4.5rem);
    text-align: center;
  }
  .hero-cabeza {
    display: grid;
    justify-items: center;
    gap: clamp(0.75rem, 2vh, 1.25rem);
  }
  .hero :global(.hero-sello) {
    /* También según la altura: en portátiles de 720–768 px la acción debe caber */
    width: clamp(5.5rem, min(4rem + 6vw, 15vh), 8.5rem);
  }
  .hero-titulo {
    margin: 0;
    font-size: var(--text-marca);
    line-height: 0.9;
    letter-spacing: var(--tracking-marca);
    text-transform: uppercase;
    /* El espaciado deja aire tras la última letra: se compensa para centrar de verdad */
    margin-right: calc(var(--tracking-marca) * -1);
  }
  .hero-tira {
    width: min(100% - 2rem, 60rem);
    margin: clamp(0.75rem, 2vh, 1.75rem) auto 0;
  }
  .hero-lema {
    margin: 0;
    padding: 0.35rem 1rem;
    background: var(--accion);
    color: var(--papel-claro);
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 1rem);
  }
  .hero-tira :global(.rasgado) {
    height: 1.1rem;
  }
  .hero-cuerpo {
    display: grid;
    justify-items: center;
    gap: clamp(0.6rem, 1.6vh, 1rem);
    margin-top: clamp(0.9rem, 2vh, 2rem);
  }
  .hero-texto {
    max-width: 38rem;
    margin: 0;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    text-wrap: pretty;
  }
  .hero-aviso {
    margin: 0;
    max-width: 34rem;
    color: var(--tinta-suave);
    font-size: 0.9375rem;
    font-style: italic;
  }
  .hero-hoy {
    margin: clamp(0.25rem, 1vh, 1.5rem) 0 0;
    color: var(--tinta-suave);
  }
  .hero-cafes {
    display: grid;
    width: 100%;
    max-width: 62rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--tinta);
  }
  @media (min-width: 48rem) {
    .hero-cafes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .hero-cafe {
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--linea);
    text-align: left;
  }
  @media (min-width: 48rem) {
    .hero-cafe {
      padding: clamp(0.6rem, 1.4vh, 1rem) 1.5rem;
      border-bottom: 0;
    }
    .hero-cafe + .hero-cafe {
      border-left: 1px solid var(--linea);
    }
  }
  .hero-cafe-fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 0;
    font-size: var(--text-plato);
  }
  .hero-cafe-nombre {
    font-family: var(--font-display);
  }
  .hero-cafe-origen {
    margin: 0.3rem 0 0;
    color: var(--tinta-suave);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
  }
  .hero-cta {
    margin-top: clamp(0rem, 0.8vh, 0.5rem);
  }
  /* En escritorio el estado vive en la cabecera */
  @media (min-width: 64rem) {
    .hero :global(.hero-estado) {
      display: none;
    }
  }
</style>
