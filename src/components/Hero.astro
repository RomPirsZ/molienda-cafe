---
// Primer viewport (contrato de dirección, FIRST VIEWPORT): la fachada de la casona a
// todo el ancho; el titular arriba a la izquierda, sobre el cielo; la pizarra de acera
// con tres cafés y su precio; abajo a la izquierda, el estado de apertura, la frase del
// origen y «Ver la carta». El aviso de concepto, bajo el titular, sin scroll.
import { t } from '../i18n';
import Fachada from './Fachada.astro';
import Pizarra from './Pizarra.astro';
import EstadoApertura from './EstadoApertura.astro';
---

<section id="inicio" class="hero" aria-labelledby="titulo">
  <div class="hero-escena">
    <Fachada />
    <Pizarra class="hero-pizarra" />
  </div>

  <div class="hero-cabeza contenedor">
    <h1 id="titulo" class="hero-titular">
      <span class="sr-only">{t('hero.oculto')}</span>{t('hero.titular')}
    </h1>
    <p class="hero-aviso">{t('concepto.aviso')}</p>
  </div>

  <div class="hero-pie contenedor">
    <div class="hero-pie-texto">
      <EstadoApertura class="hero-estado" />
      <p class="hero-texto">{t('hero.texto')}</p>
    </div>
    <a href="#carta" class="boton-accion hero-cta">
      {t('hero.cta')}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
        <path d="M12 4v15M6 13l6 6 6-6"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* El hero ocupa la pantalla bajo la cabecera; la fachada lo llena por alto (su ancho
     es 2,4 veces el alto) y se recorta por los lados, centrada en el portón */
  .hero {
    --alto: max(34rem, 100svh - 4rem);
    /* Franja de abajo para el estado y la acción: la calle sigue en el mismo color */
    --pie-alto: 6.5rem;
    /* La escena llena el alto que deja la franja; su calle (el 10 % de abajo, lisa) pasa
       por debajo de la franja, así el texto queda sobre la calle y nunca sobre el dibujo */
    --fachada-alto: max(100cqw / 2.4, (100cqh - var(--pie-alto)) / 0.9);
    --fachada-ancho: calc(var(--fachada-alto) * 2.4);
    position: relative;
    height: var(--alto);
    overflow: hidden;
    container-type: size;
  }
  .hero-escena {
    position: absolute;
    left: 50%;
    bottom: calc(var(--pie-alto) - var(--fachada-alto) * 0.1);
    width: var(--fachada-ancho);
    translate: -50% 0;
  }
  .hero-cabeza {
    position: relative;
    padding-top: clamp(1rem, 4cqh, 2.5rem);
  }
  .hero-titular {
    max-width: 15ch;
    margin: 0;
    /* También según la altura: en portátiles de 720 px el titular cabe sobre el tejado */
    font-size: min(var(--text-titular), 12.5cqh);
    line-height: 0.86;
  }
  .hero-aviso {
    max-width: 30rem;
    margin: 0.9rem 0 0;
    color: var(--pergamino-suave);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.4;
  }
  .hero-pie {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    min-height: var(--pie-alto);
    padding-block: 0.5rem;
  }
  .hero-pie-texto {
    display: grid;
    gap: 0.3rem;
    max-width: 24rem;
  }
  .hero :global(.hero-estado) {
    color: var(--frailejon);
  }
  .hero-texto {
    margin: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  /* La pizarra, delante de la ventana derecha y apoyada en la acera */
  .hero :global(.hero-pizarra) {
    position: absolute;
    left: 56%;
    bottom: 13.5%;
  }
  /* En el móvil la casona no llena el alto: se ve entera la parte del portón y las dos
     ventanas, apoyada abajo; el cielo de arriba es el mismo color que la página. El
     estado y la acción van debajo, sobre la calle, que sigue en el mismo color. */
  @media (max-width: 47.99rem) {
    .hero {
      --fachada-alto: calc(300vw / 2.4);
      --fachada-ancho: 300vw;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: auto;
      min-height: var(--alto);
      container-type: normal;
    }
    .hero-escena {
      position: relative;
      left: auto;
      bottom: auto;
      margin-top: auto;
      margin-left: calc(50% - var(--fachada-ancho) / 2);
      translate: none;
    }
    .hero-cabeza {
      order: -1;
      padding-top: 1.25rem;
    }
    .hero-titular {
      font-size: var(--text-titular);
    }
    .hero-texto {
      display: none;
    }
    .hero :global(.hero-pizarra) {
      left: auto;
      right: calc((var(--fachada-ancho) - 100vw) / 2 + 0.5rem);
      bottom: 11%;
    }
    .hero-pie {
      position: relative;
      min-height: 0;
      padding-top: 0.25rem;
      padding-bottom: 1.25rem;
    }
  }
</style>
