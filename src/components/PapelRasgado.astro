---
// Borde de papel rasgado (plan §5): pieza decorativa que se coloca en el canto de una
// franja de color. Dos capas enmascaradas con los SVG de src/assets/marcas: la fibra
// clara del canto y, encima, el color de la franja. Estático: nunca se anima.
// El color se toma de --rasgado-color en el contenedor (por defecto, la oliva).
interface Props {
  /** Canto donde va: arriba (la franja empieza) o abajo (la franja acaba) */
  lado?: 'arriba' | 'abajo';
  /** Dos variantes de corte, para que dos bordes seguidos no se vean iguales */
  corte?: 1 | 2;
}

const { lado = 'arriba', corte = 1 } = Astro.props;
---

<div class:list={['rasgado', `rasgado--${lado}`, `rasgado--corte-${corte}`]} aria-hidden="true">
  <span class="rasgado-fibra"></span>
  <span class="rasgado-color"></span>
</div>

<style>
  .rasgado {
    position: relative;
    height: 1.75rem;
    pointer-events: none;
  }
  .rasgado--abajo {
    transform: scaleY(-1);
  }
  .rasgado span {
    position: absolute;
    inset: 0;
    mask-repeat: repeat-x;
    mask-size: 1200px 100%;
    mask-position: 0 100%;
  }
  .rasgado-fibra {
    background: var(--papel-claro);
  }
  .rasgado-color {
    background: var(--rasgado-color, var(--franja));
  }
  .rasgado--corte-1 .rasgado-fibra {
    mask-image: url('../assets/marcas/borde-1-fibra.svg');
  }
  .rasgado--corte-1 .rasgado-color {
    mask-image: url('../assets/marcas/borde-1.svg');
  }
  .rasgado--corte-2 .rasgado-fibra {
    mask-image: url('../assets/marcas/borde-2-fibra.svg');
  }
  .rasgado--corte-2 .rasgado-color {
    mask-image: url('../assets/marcas/borde-2.svg');
  }
</style>
