---
// Foto de ambientación (plan §6 y §11): una ventana con overflow oculto donde la foto se
// revela (M07) sin salirse del marco. Sin JS y con reduced-motion, la foto está en su
// sitio desde el principio. Esquina recta, sin sombras.
import { Picture } from 'astro:assets';
import { t } from '../i18n';
import { FOTOS } from '../data/fotos';

interface Props {
  foto: keyof typeof FOTOS;
  /** `sizes` del <picture>: cuánto ocupa la foto en pantalla */
  sizes: string;
  /** Proporción de la ventana. Va por clase y no por style="": la CSP no admite estilos en línea */
  proporcion?: '4 / 3' | '3 / 2' | '1 / 1' | '4 / 5';
  /** La primera foto que se ve sin scroll se carga sin esperar */
  prioritaria?: boolean;
  class?: string;
}

const { foto, sizes, proporcion = '4 / 3', prioritaria = false, class: clase } = Astro.props;
const datos = FOTOS[foto];
---

<figure class:list={['foto', clase]} data-foto>
  <div class:list={['foto-ventana', `proporcion-${proporcion.replace(/\s*\/\s*/, '-')}`]}>
    <Picture
      src={datos.src}
      alt={t(datos.alt)}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600, 2000]}
      sizes={sizes}
      loading={prioritaria ? 'eager' : 'lazy'}
      fetchpriority={prioritaria ? 'high' : 'auto'}
      decoding="async"
      class="foto-img"
      data-foto-img
    />
  </div>
</figure>

<style>
  .foto {
    margin: 0;
    background: var(--espresso);
  }
  .proporcion-4-3 {
    aspect-ratio: 4 / 3;
  }
  .proporcion-3-2 {
    aspect-ratio: 3 / 2;
  }
  .proporcion-1-1 {
    aspect-ratio: 1 / 1;
  }
  .proporcion-4-5 {
    aspect-ratio: 4 / 5;
  }
  .foto-ventana {
    overflow: hidden;
  }
  .foto :global(.foto-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
