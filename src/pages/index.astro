---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import Hero from '../components/Hero.astro';
import Origen from '../components/Origen.astro';
import Carta from '../components/Carta.astro';
import Ambiente from '../components/Ambiente.astro';
import Visitanos from '../components/Visitanos.astro';
import Pie from '../components/Pie.astro';
---

<Base>
  <Cabecera />
  <main id="contenido">
    <Hero />
    <Carta />
    <Origen />
    <Ambiente />
    <Visitanos />
  </main>
  <Pie />
</Base>
